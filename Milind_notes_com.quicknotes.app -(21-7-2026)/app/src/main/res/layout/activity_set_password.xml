<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context=".ui.activity.SetPasswordActivity">

    <ImageView
        android:id="@+id/btnBack"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_password_back"
        android:contentDescription="@string/cd_back"
        android:padding="11dp"
        android:src="@drawable/ic_back"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/app_txt_black" />

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:fontFamily="sans-serif-medium"
        android:text="@string/set_password"
        android:textColor="@color/app_txt_black"
        android:textSize="20sp"
        app:layout_constraintBottom_toBottomOf="@id/btnBack"
        app:layout_constraintStart_toEndOf="@id/btnBack"
        app:layout_constraintTop_toTopOf="@id/btnBack" />

    <!-- Password / PIN / Pattern step -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/passwordStep"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnBack">

        <ImageView
            android:id="@+id/ivLock"
            android:layout_width="88dp"
            android:layout_height="88dp"
            android:layout_marginTop="36dp"
            android:background="@drawable/bg_password_lock_circle"
            android:contentDescription="@string/cd_password_lock"
            android:padding="20dp"
            android:src="@drawable/ic_password_lock"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvHeadline"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="32dp"
            android:layout_marginTop="20dp"
            android:fontFamily="@font/plus_jakarta_sans_semi_bold"
            android:gravity="center"
            android:text="@string/please_keep_password_in_mind"
            android:textColor="@color/app_txt_black"
            android:textSize="18sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/ivLock" />

        <TextView
            android:id="@+id/tvSubtitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="32dp"
            android:layout_marginTop="8dp"
            android:fontFamily="@font/plus_jakarta_sans_regular"
            android:gravity="center"
            android:text="@string/draw_a_pattern"
            android:textColor="@color/password_hint"
            android:textSize="14sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvHeadline" />

        <FrameLayout
            android:id="@+id/inputContainer"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginHorizontal="24dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"
            app:layout_constraintBottom_toTopOf="@id/btnForgotPassword"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvSubtitle">

            <com.notebook.notes.checklist.ui.password.PatternLockView
                android:id="@+id/patternLockView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/pinContainer"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:visibility="visible">

                <LinearLayout
                    android:id="@+id/pinDots"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <View
                        android:id="@+id/pinDot1"
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_marginHorizontal="12dp"
                        android:background="@drawable/bg_pin_dot_empty" />

                    <View
                        android:id="@+id/pinDot2"
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_marginHorizontal="12dp"
                        android:background="@drawable/bg_pin_dot_empty" />

                    <View
                        android:id="@+id/pinDot3"
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_marginHorizontal="12dp"
                        android:background="@drawable/bg_pin_dot_empty" />

                    <View
                        android:id="@+id/pinDot4"
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_marginHorizontal="12dp"
                        android:background="@drawable/bg_pin_dot_empty" />
                </LinearLayout>

                <TableLayout
                    android:id="@+id/pinPad"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="36dp"
                    android:stretchColumns="*">

                    <TableRow>

                        <TextView
                            android:id="@+id/key1"
                            style="@style/PasswordKeypadKey"
                            android:text="1" />

                        <TextView
                            android:id="@+id/key2"
                            style="@style/PasswordKeypadKey"
                            android:text="2" />

                        <TextView
                            android:id="@+id/key3"
                            style="@style/PasswordKeypadKey"
                            android:text="3" />
                    </TableRow>

                    <TableRow>

                        <TextView
                            android:id="@+id/key4"
                            style="@style/PasswordKeypadKey"
                            android:text="4" />

                        <TextView
                            android:id="@+id/key5"
                            style="@style/PasswordKeypadKey"
                            android:text="5" />

                        <TextView
                            android:id="@+id/key6"
                            style="@style/PasswordKeypadKey"
                            android:text="6" />
                    </TableRow>

                    <TableRow>

                        <TextView
                            android:id="@+id/key7"
                            style="@style/PasswordKeypadKey"
                            android:text="7" />

                        <TextView
                            android:id="@+id/key8"
                            style="@style/PasswordKeypadKey"
                            android:text="8" />

                        <TextView
                            android:id="@+id/key9"
                            style="@style/PasswordKeypadKey"
                            android:text="9" />
                    </TableRow>

                    <TableRow>

                        <TextView style="@style/PasswordKeypadKey" />

                        <TextView
                            android:id="@+id/key0"
                            style="@style/PasswordKeypadKey"
                            android:text="0" />

                        <ImageView
                            android:id="@+id/keyDelete"
                            android:layout_width="0dp"
                            android:layout_height="72dp"
                            android:background="?attr/selectableItemBackground"
                            android:contentDescription="@string/delete"
                            android:padding="22dp"
                            android:src="@drawable/ic_back_pass" />
                    </TableRow>
                </TableLayout>
            </LinearLayout>
        </FrameLayout>

        <TextView
            android:id="@+id/btnForgotPassword"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:fontFamily="@font/plus_jakarta_sans_medium"
            android:padding="8dp"
            android:text="@string/forgot_password"
            android:textColor="@color/password_accent"
            android:textSize="14sp"
            android:visibility="gone"
            app:layout_constraintBottom_toTopOf="@id/btnSwitchMode"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            tools:visibility="visible" />

        <LinearLayout
            android:id="@+id/btnSwitchMode"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_marginHorizontal="24dp"
            android:layout_marginBottom="28dp"
            android:background="@drawable/bg_password_pill_button"
            android:contentDescription="@string/cd_number_password"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingHorizontal="20dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <ImageView
                android:id="@+id/ivSwitchMode"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_number_password" />

            <TextView
                android:id="@+id/tvSwitchMode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:fontFamily="sans-serif-medium"
                android:text="@string/number_password"
                android:textColor="@color/password_accent"
                android:textSize="16sp" />
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Security question step -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/securityQuestionStep"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:paddingHorizontal="24dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnBack"
        tools:visibility="visible">

        <ImageView
            android:id="@+id/ivSecurityQuestion"
            android:layout_width="88dp"
            android:layout_height="88dp"
            android:layout_marginTop="36dp"
            android:background="@drawable/bg_password_lock_circle"
            android:contentDescription="@string/cd_security_question"
            android:padding="22dp"
            android:src="@drawable/ic_choose_question"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvSecurityHeadline"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:fontFamily="@font/plus_jakarta_sans_regular"
            android:gravity="center"
            android:text="@string/choose_security_question"
            android:textColor="@color/app_txt_black"
            android:textSize="18sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/ivSecurityQuestion" />
        <TextView
            android:id="@+id/tvSecurityQuestion"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:background="@drawable/bg_security_field"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/plus_jakarta_sans_medium"
            android:paddingHorizontal="20dp"
            android:paddingVertical="16dp"
            android:textColor="@color/app_txt_black"
            android:textSize="15sp"
            android:drawableEnd="@drawable/ic_ps_question_drop"
            android:drawablePadding="12dp"
            app:layout_constraintTop_toBottomOf="@id/tvSecurityHeadline"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            tools:text="What is your favorite food?" />

        <EditText
            android:id="@+id/etSecurityAnswer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_security_field"
            android:fontFamily="@font/plus_jakarta_sans_medium"
            android:hint="@string/input_your_answer"
            android:imeOptions="actionDone"
            android:inputType="textCapSentences"
            android:paddingHorizontal="20dp"
            android:paddingVertical="16dp"
            android:textColor="@color/app_txt_black"
            android:textColorHint="@color/password_hint"
            android:textSize="15sp"
            app:layout_constraintTop_toBottomOf="@id/tvSecurityQuestion"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            app:layout_constraintTop_toBottomOf="@id/etSecurityAnswer"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_height="wrap_content">
            <TextView
                android:id="@+id/btnSaveSecurityQuestion"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_password_primary_button"
                android:fontFamily="@font/plus_jakarta_sans_semi_bold"
                android:gravity="center"
                android:text="@string/save"
                android:textColor="@color/white"
                android:textSize="16sp"
                app:layout_constraintBottom_toTopOf="@id/btnSkipSecurityQuestion"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

            <TextView
                android:id="@+id/btnSkipSecurityQuestion"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginTop="15dp"

                android:background="@drawable/bg_password_pill_button"
                android:fontFamily="@font/plus_jakarta_sans_semi_bold"
                android:gravity="center"
                android:text="@string/skip"
                android:textColor="@color/password_accent"
                android:textSize="16sp"
                app:layout_constraintTop_toBottomOf="@+id/btnSaveSecurityQuestion"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
