<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_popup_category"
    android:elevation="2dp"
    android:minWidth="200dp"
    android:orientation="vertical"
    android:layout_marginEnd="16dp"
    android:paddingVertical="10dp">

    <LinearLayout
        android:id="@+id/optionRestore"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:minHeight="48dp"
        android:orientation="horizontal"
        android:paddingHorizontal="18dp"
        android:paddingVertical="8dp">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:contentDescription="@null"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_restor"
            app:tint="@color/app_txt_black" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:fontFamily="@font/plus_jakarta_sans_medium"
            android:text="@string/restore_note"
            android:textColor="@color/app_txt_black"
            android:textSize="15sp" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/optionDeletePermanently"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:minHeight="48dp"
        android:orientation="horizontal"
        android:paddingHorizontal="18dp"
        android:paddingVertical="8dp">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:contentDescription="@null"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_delete"
            app:tint="@color/text_black_2" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:fontFamily="@font/plus_jakarta_sans_medium"
            android:text="@string/empty_trash"
            android:textColor="@color/text_black_2"
            android:textSize="15sp" />

    </LinearLayout>

</LinearLayout>
