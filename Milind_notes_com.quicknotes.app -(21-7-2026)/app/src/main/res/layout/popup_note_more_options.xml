<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_popup_category"
    android:elevation="2dp"
    android:fillViewport="true"
    android:overScrollMode="never"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="200dp"
        android:orientation="vertical"
        android:paddingVertical="8dp">

        <include
            android:id="@+id/optionAddReminder"
            layout="@layout/item_note_more_option" />

        <include
            android:id="@+id/optionArchive"
            layout="@layout/item_note_more_option" />

        <include
            android:id="@+id/optionLock"
            layout="@layout/item_note_more_option" />

        <include
            android:id="@+id/optionBookmarkNote"
            layout="@layout/item_note_more_option" />

        <include
            android:id="@+id/optionReadingMode"
            layout="@layout/item_note_more_option" />

        <include
            android:id="@+id/optionSearch"
            layout="@layout/item_note_more_option" />

        <include
            android:id="@+id/optionCopy"
            layout="@layout/item_note_more_option" />

        <include
            android:id="@+id/optionExport"
            layout="@layout/item_note_more_option" />

        <include
            android:id="@+id/optionNoteDetails"
            layout="@layout/item_note_more_option" />

        <include
            android:id="@+id/optionPin"
            layout="@layout/item_note_more_option" />

        <include
            android:id="@+id/optionShare"
            layout="@layout/item_note_more_option" />

        <include
            android:id="@+id/optionDelete"
            layout="@layout/item_note_more_option" />

    </LinearLayout>

</ScrollView>
