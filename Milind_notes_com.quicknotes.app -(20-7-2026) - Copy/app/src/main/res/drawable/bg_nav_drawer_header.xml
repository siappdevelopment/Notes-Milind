<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:endColor="#FFF3F8FF"
                android:startColor="#FFFFFFFF"
                android:type="linear" />
        </shape>
    </item>
    <item
        android:bottom="24dp"
        android:gravity="top|end"
        android:right="-12dp"
        android:top="-8dp">
        <shape android:shape="rectangle">
            <size
                android:width="120dp"
                android:height="80dp" />
            <solid android:color="#1A90CAF9" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item
        android:bottom="8dp"
        android:gravity="bottom|start"
        android:left="16dp">
        <shape android:shape="oval">
            <size
                android:width="48dp"
                android:height="48dp" />
            <solid android:color="#14000000" />
        </shape>
    </item>
</layer-list>
