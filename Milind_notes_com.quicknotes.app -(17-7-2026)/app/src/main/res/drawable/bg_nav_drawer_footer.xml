<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="90"
                android:endColor="#00FFFFFF"
                android:startColor="#14D7CCC8"
                android:type="linear" />
        </shape>
    </item>
    <item
        android:bottom="8dp"
        android:gravity="bottom|start"
        android:left="24dp">
        <shape android:shape="rectangle">
            <size
                android:width="3dp"
                android:height="56dp" />
            <solid android:color="#FF8D6E63" />
            <corners android:radius="2dp" />
        </shape>
    </item>
    <item
        android:bottom="8dp"
        android:gravity="bottom|start"
        android:left="40dp">
        <shape android:shape="rectangle">
            <size
                android:width="3dp"
                android:height="72dp" />
            <solid android:color="#FF8D6E63" />
            <corners android:radius="2dp" />
        </shape>
    </item>
    <item
        android:bottom="8dp"
        android:gravity="bottom|start"
        android:left="56dp">
        <shape android:shape="rectangle">
            <size
                android:width="3dp"
                android:height="48dp" />
            <solid android:color="#FF8D6E63" />
            <corners android:radius="2dp" />
        </shape>
    </item>
    <item
        android:bottom="0dp"
        android:gravity="bottom"
        android:left="0dp"
        android:right="0dp">
        <shape android:shape="rectangle">
            <size android:height="24dp" />
            <solid android:color="#1AA1887F" />
        </shape>
    </item>
</layer-list>
