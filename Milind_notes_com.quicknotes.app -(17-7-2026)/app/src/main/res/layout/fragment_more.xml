<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    >

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_marginBottom="24dp">

            <ImageView
                android:id="@+id/btnMoreMenu"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/bg_home_menu_circle"
                android:contentDescription="@string/more_features"
                android:padding="6dp"
                android:src="@drawable/ic_menu"
                app:tint="@color/black" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:fontFamily="@font/plus_jakarta_sans_bold"
                android:text="@string/more_features"
                android:textColor="@color/black"
                android:textSize="18sp" />
        </LinearLayout>

        <!-- Top Grid: Archive & Edit Labels -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:baselineAligned="false">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardArchive"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                app:cardBackgroundColor="@color/bg_color_2"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <androidx.cardview.widget.CardView
                        android:layout_width="wrap_content"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="1dp"
                        app:cardUseCompatPadding="true"
                        android:layout_height="wrap_content">


                        <ImageView
                            android:layout_width="42dp"
                            android:layout_height="42dp"
                            android:backgroundTint="@color/white"
                            android:padding="10dp"
                            android:src="@drawable/ic_archive"
                            app:tint="#2E70D3" />

                    </androidx.cardview.widget.CardView>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="@font/plus_jakarta_sans_bold"
                        android:text="@string/nav_archive"
                        android:includeFontPadding="false"
                        android:textColor="@color/black"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:includeFontPadding="false"
                        android:layout_height="wrap_content"
                        android:text="@string/stored_thoughts"
                        android:textColor="@color/grey_1"
                        android:fontFamily="@font/plus_jakarta_sans_regular"                        android:textSize="14sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardEditLabels"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                app:cardBackgroundColor="@color/bg_color_2"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <androidx.cardview.widget.CardView
                        android:layout_width="wrap_content"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="1dp"
                        app:cardUseCompatPadding="true"
                        android:layout_height="wrap_content">


                        <ImageView
                            android:layout_width="42dp"
                            android:layout_height="42dp"
                            android:clipToOutline="true"
                            android:backgroundTint="@color/white"
                            android:padding="10dp"
                            android:src="@drawable/ic_ct_defult_lebel"
                             />

                    </androidx.cardview.widget.CardView>


                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:fontFamily="@font/plus_jakarta_sans_bold"
                        android:text="@string/edit_labels"
                        android:includeFontPadding="false"
                        android:textColor="@color/black"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/organize_tags"
                        android:includeFontPadding="false"
                        android:textColor="@color/grey_1"
                        android:fontFamily="@font/plus_jakarta_sans_regular"
                        android:textSize="14sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <!-- Section: Personalization -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:id="@+id/viewSelectedIndicator"
                android:layout_width="2dp"
                android:layout_height="22dp"
                android:background="@drawable/bg_nav_drawer_selected_indicator"
                android:visibility="gone"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:visibility="visible" />

            <TextView
                android:layout_width="wrap_content"
                android:includeFontPadding="false"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:layout_marginStart="8dp"
                android:fontFamily="@font/plus_jakarta_sans_bold"
                android:text="@string/personalization"
                android:textColor="@color/black"
                android:textSize="14sp" />
            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView
                android:layout_width="wrap_content"
                android:text="@string/see_more"
                android:id="@+id/tvseeMore"
                android:layout_gravity="end"
                android:gravity="end"
                android:textColor="@color/app_primary_color"
                android:fontFamily="@font/plus_jakarta_sans_semi_bold"
                android:layout_height="wrap_content"/>
        </LinearLayout>

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <!-- Theme 1 -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/themePurple"
                    android:layout_width="120dp"
                    android:layout_height="160dp"
                    android:layout_marginEnd="12dp"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardBackgroundColor="#E8E4F8"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:strokeColor="#6B5FCA"
                    app:strokeWidth="0dp">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:padding="12dp">

                        <View
                            android:id="@+id/theme1_line1"
                            android:layout_width="60dp"
                            android:layout_height="8dp"
                            android:background="@drawable/bg_dialog_rounded"
                            android:backgroundTint="@color/white" />

                        <View
                            android:id="@+id/theme1_line2"
                            android:layout_width="match_parent"
                            android:layout_height="4dp"
                            android:layout_below="@id/theme1_line1"
                            android:layout_marginTop="12dp"
                            android:background="@drawable/bg_dialog_rounded"
                            android:backgroundTint="@color/white" />

                        <View
                            android:id="@+id/theme1_line3"
                            android:layout_width="match_parent"
                            android:layout_height="4dp"
                            android:layout_below="@id/theme1_line2"
                            android:layout_marginTop="8dp"
                            android:background="@drawable/bg_dialog_rounded"
                            android:backgroundTint="@color/white" />

                        <ImageView
                            android:id="@+id/ivThemePurpleCheck"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_alignParentEnd="true"
                            android:layout_alignParentTop="true"
                            android:src="@drawable/ic_check"
                            android:background="@drawable/bg_circle_color"
                            android:backgroundTint="#6B5FCA"
                            android:padding="4dp"
                            android:visibility="gone"
                            app:tint="@color/white"
                            tools:visibility="visible" />
                    </RelativeLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Theme 2 -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/themePeach"
                    android:layout_width="120dp"
                    android:layout_height="160dp"
                    android:layout_marginEnd="12dp"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardBackgroundColor="#FFE5D9"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:strokeColor="#6B5FCA"
                    app:strokeWidth="0dp">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:padding="12dp">

                        <View
                            android:id="@+id/theme2_line1"
                            android:layout_width="60dp"
                            android:layout_height="8dp"
                            android:background="@drawable/bg_dialog_rounded"
                            android:backgroundTint="@color/white" />

                        <View
                            android:id="@+id/theme2_line2"
                            android:layout_width="match_parent"
                            android:layout_height="4dp"
                            android:layout_below="@id/theme2_line1"
                            android:layout_marginTop="12dp"
                            android:background="@drawable/bg_dialog_rounded"
                            android:backgroundTint="@color/white" />

                        <View
                            android:id="@+id/theme2_line3"
                            android:layout_width="match_parent"
                            android:layout_height="4dp"
                            android:layout_below="@id/theme2_line2"
                            android:layout_marginTop="8dp"
                            android:background="@drawable/bg_dialog_rounded"
                            android:backgroundTint="@color/white" />

                        <ImageView
                            android:id="@+id/ivThemePeachCheck"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_alignParentEnd="true"
                            android:layout_alignParentTop="true"
                            android:src="@drawable/ic_check"
                            android:background="@drawable/bg_circle_color"
                            android:backgroundTint="#6B5FCA"
                            android:padding="4dp"
                            android:visibility="gone"
                            app:tint="@color/white"
                            tools:visibility="visible" />
                    </RelativeLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Theme 3 -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/themeTeal"
                    android:layout_width="120dp"
                    android:layout_height="160dp"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardBackgroundColor="#D9F5E5"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:strokeColor="#6B5FCA"
                    app:strokeWidth="0dp">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:padding="12dp">

                        <View
                            android:id="@+id/theme3_line1"
                            android:layout_width="60dp"
                            android:layout_height="8dp"
                            android:background="@drawable/bg_dialog_rounded"
                            android:backgroundTint="@color/white" />

                        <View
                            android:id="@+id/theme3_line2"
                            android:layout_width="match_parent"
                            android:layout_height="4dp"
                            android:layout_below="@id/theme3_line1"
                            android:layout_marginTop="12dp"
                            android:background="@drawable/bg_dialog_rounded"
                            android:backgroundTint="@color/white" />

                        <View
                            android:id="@+id/theme3_line3"
                            android:layout_width="match_parent"
                            android:layout_height="4dp"
                            android:layout_below="@id/theme3_line2"
                            android:layout_marginTop="8dp"
                            android:background="@drawable/bg_dialog_rounded"
                            android:backgroundTint="@color/white" />

                        <ImageView
                            android:id="@+id/ivThemeTealCheck"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_alignParentEnd="true"
                            android:layout_alignParentTop="true"
                            android:src="@drawable/ic_check"
                            android:background="@drawable/bg_circle_color"
                            android:backgroundTint="#6B5FCA"
                            android:padding="4dp"
                            android:visibility="gone"
                            app:tint="@color/white"
                            tools:visibility="visible" />
                    </RelativeLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </HorizontalScrollView>

        <!-- Section: Storage & Safety -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:layout_width="2dp"
                android:layout_height="22dp"
                android:background="@drawable/bg_nav_drawer_selected_indicator"
                android:visibility="gone"
                android:layout_gravity="center_vertical"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:visibility="visible" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:fontFamily="@font/plus_jakarta_sans_bold"
                android:text="@string/storage_safety"
                android:includeFontPadding="false"
                android:textColor="@color/black"
                android:textSize="14sp"/>
        </LinearLayout>

        <!-- Trash Bin Item -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardTrashBin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="@color/bg_color_2"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="8dp">

                <androidx.cardview.widget.CardView
                    android:layout_width="wrap_content"
                    app:cardCornerRadius="13dp"
                    app:cardElevation="1dp"
                    app:cardUseCompatPadding="true"
                    android:layout_height="wrap_content">


                    <ImageView
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:clipToOutline="true"
                        android:backgroundTint="@color/white"
                        android:padding="10dp"
                        android:src="@drawable/ic_recylerbin"
                        app:tint="@color/icon_red" />

                </androidx.cardview.widget.CardView>


                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/plus_jakarta_sans_bold"
                        android:text="@string/trash_bin"
                        android:textColor="@color/black"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/restore_permanently_delete"
                        android:textColor="@color/grey_1"
                        android:textSize="12sp" />
                </LinearLayout>

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_expand_more"
                    app:tint="#8A8A8A"
                    android:rotation="270"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Sync & Backup Item -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardSyncBackup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardBackgroundColor="#F1F3F9"
            app:cardCornerRadius="20dp"
            android:visibility="gone"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <ImageView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_dialog_rounded"
                    android:backgroundTint="@color/white"
                    android:padding="12dp"
                    android:src="@drawable/ic_backup"
                    app:tint="#6B5FCA" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/plus_jakarta_sans_bold"
                        android:text="@string/sync_backup"
                        android:textColor="@color/black"
                        android:textSize="16sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/last_synced_time"
                        android:textColor="#8A8A8A"
                        android:textSize="14sp" />
                </LinearLayout>

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_expand_more"
                    app:tint="#8A8A8A"
                    android:rotation="270"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Section: Community -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:layout_width="2dp"
                android:layout_height="22dp"
                android:background="@drawable/bg_nav_drawer_selected_indicator"
                android:visibility="gone"
                android:layout_gravity="center_vertical"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:visibility="visible" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:includeFontPadding="false"
                android:fontFamily="@font/plus_jakarta_sans_bold"
                android:text="@string/community"
                android:textColor="@color/black"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Bottom Grid: Rate Us & Share App -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal"
            android:layout_marginBottom="24dp"
            android:baselineAligned="false">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardRateUs"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                app:cardBackgroundColor="#FFF0F3"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <ImageView
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:background="@drawable/bg_personalization_item"
                        android:backgroundTint="@color/white"
                        android:padding="10dp"
                        android:src="@drawable/ic_rate_us"
                        app:tint="#F53B57" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:fontFamily="@font/plus_jakarta_sans_bold"
                        android:text="@string/drawer_rate_us"
                        android:textColor="@color/black"
                        android:includeFontPadding="false"
                        android:textSize="14sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardShareApp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                app:cardBackgroundColor="@color/app_primary_color_10"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <ImageView
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:background="@drawable/bg_personalization_item"
                        android:backgroundTint="@color/white"
                        android:padding="10dp"
                        android:src="@drawable/ic_share"
                        app:tint="@color/app_primary_color" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:layout_marginTop="8dp"
                        android:fontFamily="@font/plus_jakarta_sans_bold"
                        android:text="@string/drawer_share_app"
                        android:textColor="@color/black"
                        android:textSize="14sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
