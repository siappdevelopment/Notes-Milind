<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/topBarContainer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/white">

    <LinearLayout
        android:id="@+id/homeHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"

        android:paddingTop="8dp">

        <LinearLayout
            android:id="@+id/selectionTopBar"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:paddingHorizontal="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone"
            tools:visibility="visible">

            <ImageView
                android:id="@+id/btnCancelSelection"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/cd_back"
                android:padding="6dp"
                android:src="@drawable/ic_back"
                app:tint="@color/app_txt_black" />

            <TextView
                android:id="@+id/tvSelectionCount"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="@font/plus_jakarta_sans_medium"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@color/app_txt_black"
                android:textSize="16sp"
                tools:text="1 Selected" />

            <ImageView
                android:id="@+id/btnSelectionArchive"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/archive_note"
                android:padding="8dp"
                android:src="@drawable/ic_op_archive"
                app:tint="@color/app_txt_black" />

            <TextView
                android:id="@+id/btnSelectAllNotes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:background="@drawable/bg_home_select_all_pill"
                android:fontFamily="@font/plus_jakarta_sans_medium"
                android:includeFontPadding="false"
                android:paddingHorizontal="14dp"
                android:paddingVertical="8dp"
                android:text="@string/select_all"
                android:textColor="@color/app_primary_color"
                android:textSize="13sp" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/homeToolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/btnMenu"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/bg_home_menu_circle"
                android:contentDescription="@string/home_title"
                android:padding="5dp"
                android:src="@drawable/ic_menu"
                app:tint="@color/app_txt_black" />

            <TextView
                android:id="@+id/tvHomeTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="@font/plus_jakarta_sans_bold"
                android:maxLines="1"
                android:text="@string/home_title"
                android:textColor="@color/app_txt_black"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/btnPro"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_home_pro_badge"
                android:fontFamily="@font/plus_jakarta_sans_bold"
                android:paddingHorizontal="10dp"
                android:paddingVertical="6dp"
                android:text="@string/pro_badge"
                android:includeFontPadding="false"
                android:textColor="#FF6B3A1F"
                android:textSize="14sp" />

            <ImageView
                android:id="@+id/btnSettings"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/drawer_settings"
                android:src="@drawable/ic_setting"
                app:tint="@color/app_txt_black" />

            <ImageView
                android:id="@+id/btnMore"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/drawer_more"
                android:src="@drawable/ic_more_vert"
                app:tint="@color/app_txt_black" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/homeStatusRow"
            android:layout_width="match_parent"
            android:paddingHorizontal="16dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="visible">

            <TextView
                android:id="@+id/tvNotesCountNumber"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/plus_jakarta_sans_bold"
                android:includeFontPadding="false"
                android:textColor="@color/app_txt_black"
                android:textSize="22sp"
                tools:text="10" />

            <TextView
                android:id="@+id/tvNotesCountLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:fontFamily="@font/plus_jakarta_sans_medium"
                android:includeFontPadding="false"
                android:text="@string/notes_count_label"
                android:textColor="@color/grey_1"
                android:textSize="15sp" />

            <LinearLayout
                android:id="@+id/autoSavedBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_home_auto_saved_pill"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="10dp"
                android:paddingVertical="5dp">

                <ImageView
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_drawer_sparkle"
                    app:tint="@color/app_primary_color" />

                <TextView
                    android:id="@+id/tvAutoSaved"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:fontFamily="@font/plus_jakarta_sans_medium"
                    android:includeFontPadding="false"
                    android:text="@string/auto_saved"
                    android:textColor="@color/app_primary_color"
                    android:textSize="12sp" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/searchContainer"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_home_search"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:contentDescription="@null"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_search"
            app:tint="@color/bottom_nav_unselected" />

        <EditText
            android:id="@+id/etSearch"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:fontFamily="@font/plus_jakarta_sans_medium"
            android:hint="@string/search_notepad"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:maxLength="70"
            android:maxLines="1"
            android:textColor="@color/app_txt_black"
            android:textColorHint="@color/bottom_nav_unselected"
            android:textSize="13sp" />

    </LinearLayout>
</LinearLayout>
