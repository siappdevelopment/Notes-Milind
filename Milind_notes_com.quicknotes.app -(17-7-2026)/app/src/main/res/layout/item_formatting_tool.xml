<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="48dp"
    android:layout_marginEnd="4dp"
    android:background="?attr/selectableItemBackgroundBorderless"
    android:minWidth="40dp"
    android:layout_marginStart="10dp"
    android:clickable="true"
    android:focusable="false"
    android:paddingHorizontal="6dp">

    <TextView
        android:id="@+id/tvToolLabel"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:duplicateParentState="true"
        android:gravity="center"
        android:minWidth="32dp"
        android:textColor="@color/color_formatting_tool"
        android:textSize="16sp"
        android:textStyle="bold"
        tools:text="B"
        tools:visibility="visible" />

    <FrameLayout
        android:id="@+id/flSpecialIcon"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_gravity="center"
        android:duplicateParentState="true"
        android:visibility="gone"
        tools:visibility="visible">

        <ImageView
            android:id="@+id/ivSpecialBg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:duplicateParentState="true"
            android:importantForAccessibility="no"
            android:src="@drawable/bg_parallelogram" />

        <TextView
            android:id="@+id/tvSpecialText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:duplicateParentState="true"
            android:fontFamily="@font/plus_jakarta_sans_bold"
            android:includeFontPadding="false"
            android:text="A"
            android:textColor="@color/white"
            android:textSize="14sp"
            tools:ignore="HardcodedText" />

        <ImageView
            android:id="@+id/ivSpecialIcon"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_gravity="center"
            android:contentDescription="@null"
            android:duplicateParentState="true"
            android:importantForAccessibility="no"
            android:visibility="gone" />

    </FrameLayout>

    <ImageView
        android:id="@+id/ivToolIcon"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:padding="4dp"
        android:layout_gravity="center"
        android:contentDescription="@null"
        android:duplicateParentState="true"
        android:importantForAccessibility="no"
        android:visibility="gone"
        tools:src="@drawable/ic_align_left"
        tools:visibility="gone" />

</FrameLayout>
