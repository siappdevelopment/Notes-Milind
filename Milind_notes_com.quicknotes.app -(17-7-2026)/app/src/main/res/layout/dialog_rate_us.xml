<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_rounded"
    android:paddingHorizontal="20dp"
    android:paddingVertical="10dp">

    <ImageView
        android:id="@+id/btnClose"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:padding="8dp"
        android:src="@drawable/ic_close"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/app_txt_black" />

    <ImageView
        android:id="@+id/ivIllustration"
        android:layout_width="wrap_content"
        android:layout_height="110dp"
        android:layout_marginTop="@dimen/_10sdp"
        android:src="@drawable/ic_rate_us_dialoge"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btnClose" />

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"

        android:fontFamily="@font/plus_jakarta_sans_bold"
        android:text="@string/rate_us_title"
        android:textColor="@color/app_txt_black"
        android:textSize="18sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/ivIllustration" />

    <TextView
        android:id="@+id/tvDescription"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:fontFamily="@font/plus_jakarta_sans_medium"
        android:gravity="center"
        android:paddingHorizontal="16dp"
        android:text="@string/rate_us_description"
        android:textColor="@color/grey_1"
        android:textSize="12sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvTitle" />

    <LinearLayout
        android:id="@+id/ratingContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:background="@drawable/bg_rating_box"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvDescription">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/star1"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_marginHorizontal="4dp"
                android:src="@drawable/ic_star_filled" />

            <ImageView
                android:id="@+id/star2"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_marginHorizontal="4dp"
                android:src="@drawable/ic_star_outline"
                app:tint="@color/grey_1" />

            <ImageView
                android:id="@+id/star3"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_marginHorizontal="4dp"
                android:src="@drawable/ic_star_outline"
                app:tint="@color/grey_1" />

            <ImageView
                android:id="@+id/star4"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_marginHorizontal="4dp"
                android:src="@drawable/ic_star_outline"
                app:tint="@color/grey_1" />

            <ImageView
                android:id="@+id/star5"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_marginHorizontal="4dp"
                android:src="@drawable/ic_star_outline"
                app:tint="@color/grey_1" />

        </LinearLayout>

        <TextView
            android:id="@+id/tvHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="@font/plus_jakarta_sans_medium"
            android:text="@string/rate_us_tap_hint"
            android:textColor="@color/grey_1"
            android:textSize="13sp" />

    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSubmit"
        android:layout_width="0dp"
        android:layout_height="58dp"
        android:layout_marginTop="16dp"
        android:fontFamily="@font/plus_jakarta_sans_bold"
        android:includeFontPadding="false"
        android:text="@string/rate_us_submit"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:textSize="16sp"
        app:backgroundTint="@color/app_primary_color"
        app:cornerRadius="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/ratingContainer" />

    <TextView
        android:id="@+id/btnMaybeLater"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:background="?attr/selectableItemBackground"
        android:fontFamily="@font/plus_jakarta_sans_bold"
        android:includeFontPadding="false"
        android:padding="8dp"
        android:text="@string/rate_us_maybe_later"
        android:textColor="@color/grey_1"
        android:textSize="14sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnSubmit" />

</androidx.constraintlayout.widget.ConstraintLayout>