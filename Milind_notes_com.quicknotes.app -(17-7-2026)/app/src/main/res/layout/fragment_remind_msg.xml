<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_5sdp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="@dimen/_10sdp"
                        android:layout_marginVertical="@dimen/_5sdp"
                        android:background="@drawable/bg_create"
                        android:clickable="true"
                        android:focusable="true"
                        android:orientation="horizontal"
                        android:paddingStart="@dimen/_5sdp">

                        <CheckBox
                            android:id="@+id/checkBoxIntro1"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:button="@drawable/round_checkbox"
                            android:fontFamily="@font/manrope_semibold"
                            android:foreground="@null"
                            android:paddingVertical="@dimen/_12sdp"
                            android:paddingStart="@dimen/_8sdp"
                            android:pointerIcon="text"
                            android:text="Sorry, I can’t talk right now"
                            android:textColor="@color/black"
                            android:textSize="@dimen/_12sdp" />

                        <ImageView
                            android:id="@+id/send_one"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:layout_gravity="center"
                            android:layout_marginEnd="@dimen/_10sdp"
                            android:padding="10dp"
                            android:src="@drawable/iv_send_msg"
                            app:tint="@color/black" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="@dimen/_10sdp"
                        android:layout_marginVertical="@dimen/_5sdp"
                        android:background="@drawable/bg_create"
                        android:clickable="true"
                        android:focusable="true"
                        android:orientation="horizontal"
                        android:paddingStart="@dimen/_5sdp">

                        <CheckBox
                            android:id="@+id/checkBoxIntro2"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="@font/manrope_semibold"
                            android:button="@drawable/round_checkbox"

                            android:foreground="@null"
                            android:paddingVertical="@dimen/_12sdp"
                            android:paddingStart="@dimen/_8sdp"
                            android:pointerIcon="text"
                            android:text="Can I call you later"
                            android:textColor="@color/black"
                            android:textSize="@dimen/_12sdp" />

                        <ImageView
                            android:id="@+id/send_two"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:layout_gravity="center"
                            android:layout_marginEnd="@dimen/_10sdp"
                            android:padding="10dp"
                            android:src="@drawable/iv_send_msg"
                            android:visibility="gone"
                            app:tint="@color/black" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="@dimen/_10sdp"
                        android:layout_marginVertical="@dimen/_5sdp"
                        android:background="@drawable/bg_create"
                        android:clickable="true"
                        android:focusable="true"
                        android:orientation="horizontal"
                        android:paddingStart="@dimen/_5sdp">

                        <CheckBox
                            android:id="@+id/checkBoxIntro3"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="@font/manrope_semibold"
                            android:foreground="@null"
                            android:paddingVertical="@dimen/_12sdp"
                            android:paddingStart="@dimen/_8sdp"
                            android:pointerIcon="text"
                            android:button="@drawable/round_checkbox"
                            android:text="I’m on my way"
                            android:textColor="@color/black"
                            android:textSize="@dimen/_12sdp" />

                        <ImageView
                            android:id="@+id/send_three"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:layout_gravity="center"
                            android:layout_marginEnd="@dimen/_10sdp"
                            android:padding="10dp"
                            android:src="@drawable/iv_send_msg"
                            android:visibility="gone"
                            app:tint="@color/black" />

                    </LinearLayout>

                </LinearLayout>

            </RelativeLayout>

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/_10sdp"
                android:layout_marginVertical="@dimen/_5sdp"
                android:background="@drawable/bg_message"
                android:paddingTop="12dp"
                android:paddingBottom="12dp">

                <LinearLayout
                    android:id="@+id/layoutedit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/_5sdp">

                    <ImageView
                        android:id="@+id/ic_call"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_marginStart="10dp"
                        android:layout_marginTop="3dp"
                        android:src="@drawable/ic_edit2"
                        app:tint="@color/grey_2" />

                    <EditText
                        android:id="@+id/edittxt"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:background="@null"
                        android:fontFamily="@font/manrope_semibold"
                        android:gravity="top"
                        android:hint="Write Personal Message"
                        android:includeFontPadding="false"
                        android:lines="3"
                        android:maxLines="3"
                        android:textColor="@color/black"
                        android:textColorHint="@color/black1"
                        android:textSize="@dimen/_13sdp" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/send_five"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_below="@+id/layoutedit"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:layout_gravity="end"
                    android:layout_marginEnd="@dimen/_10sdp"
                    android:padding="10dp"
                    android:src="@drawable/iv_send_msg"
                    app:tint="@color/grey_1" />

            </RelativeLayout>

        </LinearLayout>

    </ScrollView>

</RelativeLayout>
