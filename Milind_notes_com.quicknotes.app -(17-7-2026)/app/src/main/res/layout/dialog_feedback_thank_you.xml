<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="28dp"
    android:paddingEnd="28dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_dialog_rounded"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="28dp"
        android:paddingBottom="24dp">

        <ImageView
            android:layout_width="62dp"
            android:layout_height="62dp"
            android:padding="12dp"
            android:contentDescription="@null"
            android:background="@drawable/bg_feedback_success"
            android:src="@drawable/ic_feedback_success_check" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:fontFamily="@font/plus_jakarta_sans_bold"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="@string/feedback_thank_you_title"
            android:textColor="@color/text_black_2"
            android:textSize="22sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:fontFamily="@font/plus_jakarta_sans_medium"
            android:gravity="center"
            android:includeFontPadding="false"
            android:lineSpacingExtra="2dp"
            android:text="@string/feedback_thank_you_message"
            android:textColor="@color/grey_1"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/btnBackToNotes"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="22dp"
            android:background="@drawable/bg_feedback_dialog_button"
            android:fontFamily="@font/plus_jakarta_sans_semi_bold"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="@string/feedback_back_to_notes"
            android:textColor="@color/white"
            android:textSize="15sp" />
    </LinearLayout>
</FrameLayout>
