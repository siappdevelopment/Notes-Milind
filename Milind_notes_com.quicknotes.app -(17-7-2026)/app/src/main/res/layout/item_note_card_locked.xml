<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/note_card_margin"
    app:cardBackgroundColor="@android:color/transparent"
    app:cardCornerRadius="@dimen/note_card_corner_radius"
    app:cardElevation="0dp"
    app:strokeWidth="0dp">

    <!-- Themed note background (color / gradient / theme) lives here -->
    <FrameLayout
        android:id="@+id/cardContainer"
        android:layout_width="match_parent"
        android:layout_height="210dp"
        android:clipToOutline="true">

        <!-- Decorative silhouettes under frost (non-sensitive “blurred preview”) -->
        <LinearLayout
            android:id="@+id/blurredPreviewSilhouette"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:alpha="0.45"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="56dp"
            android:paddingBottom="24dp">

            <View
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="@drawable/bg_locked_silhouette_dot" />

            <View
                android:layout_width="match_parent"
                android:layout_height="10dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_locked_silhouette_line" />

            <View
                android:layout_width="match_parent"
                android:layout_height="10dp"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="48dp"
                android:background="@drawable/bg_locked_silhouette_line" />

            <View
                android:layout_width="match_parent"
                android:layout_height="10dp"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="36dp"
                android:background="@drawable/bg_locked_silhouette_line" />

            <View
                android:layout_width="match_parent"
                android:layout_height="10dp"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="64dp"
                android:background="@drawable/bg_locked_silhouette_line" />
        </LinearLayout>

        <!-- Soft frost over theme + silhouette -->
        <View
            android:id="@+id/ivBlurView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_locked_frosted_overlay" />

        <!-- Sharp lock UI above frost -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/lockedOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:id="@+id/layoutSecuredPill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_secured_pill"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp"
                android:paddingVertical="4dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <ImageView
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_lock"
                    app:tint="@color/locked_secured_text" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:fontFamily="@font/plus_jakarta_sans_medium"
                    android:maxLines="1"
                    android:text="@string/secured"
                    android:textColor="@color/locked_secured_text"
                    android:textSize="10sp" />

            </LinearLayout>

            <ImageView
                android:id="@+id/btnMore"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="14dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/drawer_more"
                android:padding="2dp"
                android:src="@drawable/ic_more_vert"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:tint="@color/locked_secured_text" />

            <LinearLayout
                android:id="@+id/lockedContent"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingTop="8dp"
                android:paddingBottom="12dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/layoutSecuredPill">


                <FrameLayout
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:layout_marginBottom="2dp">

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_gravity="top|end"
                        android:layout_marginTop="12dp"
                        android:layout_marginEnd="8dp"
                        android:visibility="gone"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_locked_sparkle"
                        app:tint="@color/locked_note_subtitle" />

                    <ImageView
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:layout_gravity="bottom|start"
                        android:layout_marginStart="8dp"
                        android:layout_marginBottom="22dp"
                        android:contentDescription="@null"
                        android:visibility="gone"
                        android:src="@drawable/ic_locked_sparkle"
                        app:tint="@color/locked_note_subtitle" />

                    <FrameLayout
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:layout_gravity="center"
                        android:background="@drawable/bg_locked_note_icon_circle">

                        <ImageView
                            android:id="@+id/ivLock"
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:layout_gravity="center"
                            android:contentDescription="@string/locked_note"
                            android:src="@drawable/ic_ls_lock" />
                    </FrameLayout>
                </FrameLayout>

                <TextView
                    android:id="@+id/tvTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/plus_jakarta_sans_bold"
                    android:text="@string/locked_note"
                    android:textColor="@color/locked_note_title"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tvSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="8dp"
                    android:layout_marginTop="8dp"
                    android:fontFamily="@font/plus_jakarta_sans_medium"
                    android:gravity="center"
                    android:lineSpacingExtra="2dp"
                    android:text="@string/locked_note_subtitle"
                    android:textColor="@color/locked_note_subtitle"
                    android:textSize="10sp" />
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </FrameLayout>

</com.google.android.material.card.MaterialCardView>
