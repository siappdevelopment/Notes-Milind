<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.activity.CallPermissionActivity">





    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"

        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/btnAllow"
        android:layout_height="wrap_content">

        <com.google.android.material.imageview.ShapeableImageView
            android:layout_width="100dp"
            android:src="@drawable/ic_call_permission"
            android:id="@+id/ivWelcom"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:layout_height="100dp"/>

        <com.google.android.material.textview.MaterialTextView
            android:layout_width="wrap_content"
            android:id="@+id/tvHeadline"
            android:textColor="@color/black"
            android:textSize="24dp"
            android:layout_marginTop="20dp"
            android:fontFamily="sans-serif-black"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/ivWelcom"
            android:text="@string/call_permission"
            android:layout_height="wrap_content"/>
        <com.google.android.material.textview.MaterialTextView
            android:layout_width="wrap_content"
            android:id="@+id/tvDec"
            android:textColor="@color/black"
            android:textSize="14dp"
            android:textAlignment="center"
            android:paddingHorizontal="20dp"
            android:layout_marginTop="20dp"
            android:fontFamily="sans-serif-medium"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvHeadline"
            android:text="@string/allow_call_permission_dec"
            android:layout_height="wrap_content"/>
    </androidx.constraintlayout.widget.ConstraintLayout>




    <com.google.android.material.button.MaterialButton
        android:layout_width="match_parent"
        android:text="@string/allow"
        android:id="@+id/btnAllow"
        android:layout_marginHorizontal="15dp"
        android:layout_marginBottom="20dp"
        android:paddingHorizontal="20dp"
        android:textSize="20dp"
        app:layout_constraintBottom_toTopOf="@id/llOtherScreenAds"
        android:layout_height="60dp"/>

    <include
        android:id="@+id/llOtherScreenAds"
        layout="@layout/layout_other_screen_ads"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>