<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_locked_frosted_overlay">

    <TextView
        android:id="@+id/tvSecuredPill"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_secured_pill"
        android:drawablePadding="6dp"
        android:fontFamily="@font/plus_jakarta_sans_medium"
        android:gravity="center_vertical"
        android:maxLines="1"
        android:paddingHorizontal="12dp"
        android:paddingVertical="6dp"
        android:text="@string/secured"
        android:textColor="@color/locked_secured_text"
        android:textSize="11sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:drawableStart="@drawable/ic_lock" />

    <ImageView
        android:id="@+id/ivSparkleTop"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:layout_marginStart="8dp"
        android:layout_marginTop="2dp"
        android:visibility="gone"
        android:contentDescription="@null"
        android:src="@drawable/ic_locked_sparkle"
        app:layout_constraintStart_toEndOf="@id/tvSecuredPill"
        app:layout_constraintTop_toTopOf="@id/tvSecuredPill" />

    <LinearLayout
        android:id="@+id/lockedContent"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="50dp"
        android:paddingBottom="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <FrameLayout
            android:layout_width="90dp"
            android:layout_height="90dp"
            android:layout_marginBottom="2dp">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="8dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_locked_sparkle"
                app:tint="@color/locked_note_subtitle" />

            <ImageView
                android:id="@+id/ivSparkleMid"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:layout_gravity="bottom|start"
                android:layout_marginStart="8dp"
                android:layout_marginBottom="22dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_locked_sparkle"
                app:tint="@color/locked_note_subtitle" />

            <FrameLayout
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_locked_note_icon_circle"
                android:elevation="0dp">

                <ImageView
                    android:id="@+id/ivLock"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/locked_note"
                    android:src="@drawable/ic_ls_lock" />
            </FrameLayout>
        </FrameLayout>

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/plus_jakarta_sans_bold"
            android:text="@string/locked_note"
            android:textColor="@color/locked_note_title"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/tvSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginHorizontal="12dp"
            android:fontFamily="@font/plus_jakarta_sans_medium"
            android:gravity="center"
            android:lineSpacingExtra="2dp"
            android:text="@string/locked_note_subtitle"
            android:textColor="@color/locked_note_subtitle"
            android:textSize="11sp" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
