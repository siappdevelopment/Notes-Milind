<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet_rounded"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingHorizontal="24dp"
    android:paddingVertical="10dp">

    <FrameLayout
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_circle_light_purple">

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="center"
            android:contentDescription="@string/allow_reminder_access"
            android:src="@drawable/ic_permission_reminder"
            app:tint="@color/app_primary_color" />
    </FrameLayout>

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:fontFamily="@font/plus_jakarta_sans_semi_bold"
        android:text="@string/allow_reminder_access"
        android:textColor="@color/app_txt_black"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:fontFamily="@font/plus_jakarta_sans_regular"
        android:gravity="center"
        android:lineSpacingExtra="4dp"
        android:text="@string/allow_reminder_access_desc"
        android:textColor="@color/grey_1"
        android:textSize="16sp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnAllow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:fontFamily="@font/plus_jakarta_sans_medium"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:padding="14dp"
        android:text="@string/allow_permission"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:textSize="18sp"
        app:backgroundTint="@color/app_primary_color"
        app:cornerRadius="20dp" />

    <TextView
        android:id="@+id/btnMaybeLater"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="8dp"
        android:fontFamily="@font/plus_jakarta_sans_medium"
        android:padding="8dp"
        android:text="@string/maybe_later"
        android:textColor="@color/app_txt_black"
        android:textSize="16sp" />

</LinearLayout>
