<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet_rounded"
    android:orientation="vertical"

    android:paddingTop="15dp"
    android:paddingBottom="24dp">

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_marginHorizontal="18dp"
        android:layout_height="wrap_content"
        android:text="@string/create_new_label"
        android:textSize="16dp"
        android:fontFamily="@font/plus_jakarta_sans_semi_bold"
        android:textAppearance="?attr/textAppearanceTitleMedium"
        android:textColor="@color/app_txt_black"
       />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        android:background="@color/bg_stroke" />

    <EditText
        android:id="@+id/etLabelName"
        android:layout_width="match_parent"
        android:layout_marginHorizontal="18dp"
        android:layout_height="48dp"
        android:background="@drawable/bg_create_label_input"
        android:hint="@string/label_name_hint"
        android:imeOptions="actionDone"
        android:inputType="text|textCapSentences"
        android:maxLines="1"
        android:maxLength="20"
        android:paddingHorizontal="16dp"
        android:textSize="14dp"
        android:textAppearance="?attr/textAppearanceBodyLarge"
        android:textColor="@color/app_txt_black"
        android:textColorHint="@color/grey_1" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvSuggestions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="18dp"
        android:layout_marginTop="16dp"
        android:nestedScrollingEnabled="false"
        android:overScrollMode="never" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:layout_marginHorizontal="18dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancel"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_create_label_cancel_btn"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="@string/cancel"
            android:textAllCaps="false"
            android:textColor="@color/app_primary_color"
            app:backgroundTint="@null"
            app:cornerRadius="28dp"
            android:textSize="14sp"
            app:rippleColor="@color/label_sheet_cancel_bg" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAdd"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="@string/add_label"
            android:textAllCaps="true"
            android:textSize="14sp"
            android:textColor="@color/white"
            app:backgroundTint="@color/app_primary_color"
            app:cornerRadius="18dp" />

    </LinearLayout>

</LinearLayout>
