<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingHorizontal="12dp"
    android:paddingVertical="6dp">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardTileStart"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:strokeWidth="0dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageView
                android:id="@+id/ivImageStart"
                android:layout_width="match_parent"
                android:layout_height="164dp"
                android:contentDescription="@string/add_image"
                android:scaleType="centerCrop" />

            <ImageView
                android:id="@+id/ivPlayStart"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_media_play_overlay"
                android:contentDescription="@string/play"
                android:padding="10dp"
                android:src="@drawable/ic_play"
                android:visibility="gone"
                app:tint="@color/white" />

            <TextView
                android:id="@+id/tvLabelStart"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:background="@drawable/bg_media_label_overlay"
                android:ellipsize="end"
                android:maxLines="1"
                android:paddingHorizontal="10dp"
                android:paddingVertical="8dp"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="@color/white"
                android:visibility="gone" />

            <ImageButton
                android:id="@+id/btnMoreStart"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_gravity="top|end"
                android:layout_margin="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/more_options"
                android:padding="6dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_more_vert"
                app:tint="@color/white" />
        </FrameLayout>
    </com.google.android.material.card.MaterialCardView>

    <Space
        android:id="@+id/mediaTileSpacer"
        android:layout_width="8dp"
        android:layout_height="1dp" />

    <Space
        android:id="@+id/mediaTilePlaceholder"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_weight="1"
        android:visibility="gone" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardTileEnd"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:visibility="gone"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:strokeWidth="0dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageView
                android:id="@+id/ivImageEnd"
                android:layout_width="match_parent"
                android:layout_height="164dp"
                android:contentDescription="@string/add_image"
                android:scaleType="centerCrop" />

            <ImageView
                android:id="@+id/ivPlayEnd"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_media_play_overlay"
                android:contentDescription="@string/play"
                android:padding="10dp"
                android:src="@drawable/ic_play"
                android:visibility="gone"
                app:tint="@color/white" />

            <TextView
                android:id="@+id/tvLabelEnd"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:background="@drawable/bg_media_label_overlay"
                android:ellipsize="end"
                android:maxLines="1"
                android:paddingHorizontal="10dp"
                android:paddingVertical="8dp"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="@color/white"
                android:visibility="gone" />

            <ImageButton
                android:id="@+id/btnMoreEnd"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_gravity="top|end"
                android:layout_margin="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/more_options"
                android:padding="6dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_more_vert"
                app:tint="@color/white" />
        </FrameLayout>
    </com.google.android.material.card.MaterialCardView>

</LinearLayout>
