<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Checked State: Solid Circle (Doot) -->
    <item android:state_checked="true">
        <shape android:shape="oval">
            <solid android:color="@color/app_primary_color" />
            <size
                android:width="22dp"
                android:height="22dp" />
        </shape>
    </item>

    <!-- Unchecked State: Empty Ring -->
    <item>
        <shape android:shape="oval">
            <stroke
                android:width="2dp"
                android:color="@color/app_primary_color" />
            <size
                android:width="22dp"
                android:height="22dp" />
        </shape>
    </item>

</selector>