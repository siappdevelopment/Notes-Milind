<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawingTopToolbar"
    android:layout_width="match_parent"
    android:layout_height="@dimen/rich_text_toolbar_height"
    android:background="?attr/colorSurface"
    android:paddingHorizontal="@dimen/rich_text_toolbar_padding_horizontal">

    <ImageView
        android:id="@+id/btnBack"
        android:layout_width="35dp"
        android:layout_height="35dp"
        android:background="@drawable/bg_view_toggle_active"
        android:clickable="true"
        android:contentDescription="@string/cd_back"
        android:focusable="true"
        android:padding="10dp"
        android:src="@drawable/ic_back"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/app_txt_black" />

    <LinearLayout
        android:id="@+id/groupUndoRedo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintHorizontal_bias="0.8"
        android:layout_marginStart="10dp"
        app:layout_constraintEnd_toStartOf="@+id/groupActionsEnd"
        app:layout_constraintStart_toEndOf="@+id/btnBack"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/btnUndo"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="@string/undo"
            android:focusable="true"
            android:padding="12dp"
            android:src="@drawable/ic_undo"
            app:tint="@color/color_rich_text_toolbar_icon" />

        <ImageView
            android:id="@+id/btnRedo"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="@string/redo"
            android:focusable="true"
            android:padding="12dp"
            android:src="@drawable/ic_redu"
            app:tint="@color/color_rich_text_toolbar_icon" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/groupActionsEnd"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/btnDone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_done"
            android:clickable="true"
            android:contentDescription="@string/done"
            android:focusable="true"
            android:fontFamily="@font/plus_jakarta_sans_medium"
            android:paddingHorizontal="20dp"
            android:paddingVertical="8dp"
            android:text="@string/done"
            android:textAppearance="?attr/textAppearanceLabelLarge"
            android:textColor="@color/app_txt_black" />

        <ImageView
            android:id="@+id/btnMore"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="@string/more_tools"
            android:focusable="true"
            android:padding="12dp"
            android:src="@drawable/ic_more_vert"
            app:tint="@color/app_txt_black" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
